(format LCTRS)
(theory Ints)
(fun start  (-> Int Int Int))
(fun first  (-> Int Int Int))
(fun second (-> Int Int Int))
(fun end    (-> Int Int Int))
(entrypoint start)
(rule (start X Y) (first X Y))
(rule (first X Y) (first (- X 1) Y) :guard (> X 0))
(rule (first X Y) (second X Y) :guard (<= X 0))
(rule (second X Y) (second X (- Y 2)) :guard (> Y 0))
(rule (second X Y) (end X Y) :guard (<= Y 0))
