(format LCTRS)
(theory Ints)
(fun start (-> Int Int Int))
(fun mid   (-> Int Int Int))
(fun loop  (-> Int Int Int))
(fun end   (-> Int Int Int))
(entrypoint start)
(rule (start X Y) (mid X Y) :guard (>= X Y))
(rule (start X Y) (loop X Y) :guard (< X Y))
(rule (mid X Y) (end X Y))
(rule (loop X Y) (loop (- X 1) (+ Y 1)) :guard (> X Y))
(rule (loop X Y) (end X Y) :guard (<= X Y))
